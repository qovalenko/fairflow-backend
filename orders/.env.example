PORT=3010
HOST=0.0.0.0
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/fairflow
GRPC_ORDERS_PORT=5006
AUTH_GRPC_URL=127.0.0.1:5001
# [#19] control gRPC for domain-side deferred-scope hydration (large-org visibility).
CONTROL_GRPC_URL=127.0.0.1:5002
GATEWAY_KEY_CACHE_TTL_MS=60000

# Cross-domain source reads for the per-field drift-check (OQ-MORD-3, contract 3.14/3.15).
CONTACT_GRPC_URL=127.0.0.1:5003
COMPANY_GRPC_URL=127.0.0.1:5004
# Read-only deal lookup for the `deal.name` document variable (TODO-207).
PIPE_GRPC_URL=127.0.0.1:5005
# s2s api-key orders→contact/company (falls back to GATEWAY_SERVICE_API_KEY).
ORDERS_SERVICE_API_KEY=
# GATEWAY_SERVICE_API_KEY=
ORDERS_SOURCE_READ_TIMEOUT_MS=2000

JWT_SECRET=change-me-in-production
JWT_EXPIRE=7d

CORS_ORIGIN=*
CORS_CREDENTIALS=false

SLEEP_BEFORE_SHUTDOWN_MS=5000
FORCE_SHUTDOWN_TIMEOUT_MS=30000

LOG_LEVEL=debug

# --- Inbound bus / project-purge consumer (control.project.purged -> drop per-project data) ---
RABBITMQ_URL=amqp://fairflow:fairflow@localhost:5672/
# Toggle the project-purge consumer across CRM domains (default: enabled).
PROJECT_PURGE_CONSUMERS_ENABLED=true
