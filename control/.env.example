PORT=3002
GRPC_PORT=5002
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://fairflow:fairflow@localhost:5432/fairflow

# Auth gRPC — ApiKeyGrpc.ValidateServiceApiKey (must reach auth before business RPCs work)
AUTH_GRPC_URL=127.0.0.1:5001

# Pipe / orders / documents / automation — domain provisioning & lifecycle (s2s)
PIPE_GRPC_URL=127.0.0.1:5005
ORDERS_GRPC_URL=127.0.0.1:5006
DOCUMENTS_GRPC_URL=127.0.0.1:5010
AUTOMATION_GRPC_URL=127.0.0.1:5012


LOG_LEVEL=debug

GRPC_REFLECTION_ENABLED=false

# Service key (ak_…, scope internal:user-directory) for auth UserDirectoryGrpc.ResolveUsers
# (participant name/email lookup). Falls back to GATEWAY_SERVICE_API_KEY when unset.
CONTROL_SERVICE_API_KEY=

# TODO-087: at-rest encryption key for ProjectIntegration.secret (REST token /
# DB password / Kafka SASL). AES-256-GCM, key = SHA-256 of this passphrase.
# >=16 chars. FAIL-CLOSED on BOTH paths: without it saving an integration secret
# is refused (never a plaintext fallback at rest), and an already-stored secret
# cannot be read — such a webhook is dead-lettered instead of being POSTed
# unsigned. Control logs an ERROR at startup when this is unset.
FF_SECRET_ENCRYPTION_KEY=
