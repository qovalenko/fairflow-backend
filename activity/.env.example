HTTP_PORT=3008
GRPC_ACTIVITY_PORT=5008

MONGODB_URI=mongodb://root:fairflow@localhost:27017/fairflow?authSource=admin

AUTH_GRPC_URL=127.0.0.1:5001
# [#19] control gRPC for domain-side deferred-scope hydration (large-org visibility)
# and SEC-PEP-2 assignee ∈ ProjectMember validation (ProjectGrpc.ListMembers).
CONTROL_GRPC_URL=127.0.0.1:5002
# SEC-PEP-2 member-set cache TTL / control call timeout (ms). On control down the
# assignee check is fail-closed → the mutation is rejected with gRPC UNAVAILABLE.
CONTROL_MEMBERS_CACHE_TTL_MS=30000
CONTROL_MEMBERS_TIMEOUT_MS=3000

# Cross-domain donors for link nameSnapshot resolution (P2.d). Read-only s2s gRPC.
CONTACT_GRPC_URL=127.0.0.1:5003
COMPANY_GRPC_URL=127.0.0.1:5004
PIPE_GRPC_URL=127.0.0.1:5005
ORDERS_GRPC_URL=127.0.0.1:5006
# Service-to-service API key presented to donor domains (falls back to GATEWAY_SERVICE_API_KEY).
ACTIVITY_SERVICE_API_KEY=
# Per-donor RPC timeout for name resolution (ms); on timeout the snapshot stays empty (not orphaned).
ACTIVITY_NAME_RESOLVE_TIMEOUT_MS=2000

NODE_ENV=development

GRPC_REFLECTION_ENABLED=false

# --- Inbound bus / project-purge consumer (control.project.purged -> drop per-project data) ---
RABBITMQ_URL=amqp://fairflow:fairflow@localhost:5672/
# Toggle the project-purge consumer across CRM domains (default: enabled).
PROJECT_PURGE_CONSUMERS_ENABLED=true
