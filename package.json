{
  "name": "fairflow-services",
  "version": "1.0.0",
  "private": true,
  "description": "Fairflow microservices monorepo",
  "workspaces": [
    "shared",
    "testing",
    "auth",
    "control",
    "contact",
    "company",
    "documents",
    "product",
    "gateway",
    "activity",
    "orders",
    "pipe",
    "automation",
    "notification",
    "reports",
    "search",
    "audit",
    "billing",
    "chat"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @fairflow/shared",
    "build:testing": "npm run build -w @fairflow/testing",
    "build:testkit": "npm run build:shared && npm run build:testing",
    "sync:box-harness-js": "node testing/scripts/sync-box-harness-js.mjs",
    "start:infra": "cd docker && (test -f .env || cp .env.example .env) && docker compose up -d",
    "stop:infra": "cd docker && docker compose down",
    "infra:logs": "cd docker && docker compose logs -f",
    "db:migrate:auth": "cd auth && npx prisma migrate deploy",
    "db:migrate:control": "cd control && npx prisma migrate deploy",
    "db:migrate:gateway": "cd gateway && npx prisma migrate deploy",
    "db:migrate:billing": "cd billing && npx prisma migrate deploy",
    "db:seed:postgres": "npm run build:shared && cd auth && npx prisma generate && cd ../control && npx prisma generate && cd .. && npx ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/postgres-seed.ts",
    "db:seed:auth-users": "npm run build:shared && cd auth && npx prisma generate && cd .. && npx ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/seed-auth-users.ts",
    "db:provision": "npm run build:shared && cd auth && npx prisma migrate deploy && npx prisma generate && cd ../control && npx prisma migrate deploy && npx prisma generate && cd ../gateway && npx prisma migrate deploy && npx prisma generate && cd ../billing && npx prisma migrate deploy && npx prisma generate && cd .. && npm run db:seed:postgres",
    "db:provision:box": "npm run build:shared && cd auth && npx prisma migrate deploy && npx prisma generate && cd ../control && npx prisma migrate deploy && npx prisma generate && cd ../gateway && npx prisma migrate deploy && npx prisma generate && cd .. && npm run db:provision:box:keys",
    "db:provision:box:keys": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/provision-box.ts",
    "db:seed:mongo": "cd contact && npx ts-node scripts/seed-mongo.ts",
    "db:seed:demo": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/seed-demo.ts",
    "seed:all": "npm run db:provision && npm run db:seed:mongo",
    "start:auth": "cd auth && npm run start:prod",
    "start:auth:dev": "cd auth && npm run start:dev",
    "start:control": "cd control && npm run start:prod",
    "start:control:dev": "cd control && npm run start:dev",
    "start:contact": "cd contact && npm run start:prod",
    "start:contact:dev": "cd contact && npm run start:dev",
    "start:company": "cd company && npm run start:prod",
    "start:company:dev": "cd company && npm run start:dev",
    "start:activity": "cd activity && npm run start:prod",
    "start:activity:dev": "cd activity && npm run start:dev",
    "start:product": "cd product && npm run start:prod",
    "start:product:dev": "cd product && npm run start:dev",
    "start:pipe": "cd pipe && npm run start:prod",
    "start:pipe:dev": "cd pipe && npm run start:dev",
    "start:orders": "cd orders && npm run start:prod",
    "start:orders:dev": "cd orders && npm run start:dev",
    "start:gateway": "cd gateway && npm run start:prod",
    "start:gateway:dev": "cd gateway && npm run start:dev",
    "start:reports:dev": "cd reports && npm run start:dev",
    "start:reports": "cd reports && npm run start:prod",
    "start:search:dev": "cd search && npm run start:dev",
    "start:search": "cd search && npm run start:prod",
    "start:documents:dev": "cd documents && npm run start:dev",
    "start:documents": "cd documents && npm run start:prod",
    "start:automation:dev": "cd automation && npm run start:dev",
    "start:automation": "cd automation && npm run start:prod",
    "start:notification:dev": "cd notification && npm run start:dev",
    "start:notification": "cd notification && npm run start:prod",
    "start:audit:dev": "cd audit && npm run start:dev",
    "start:audit": "cd audit && npm run start:prod",
    "start:billing:dev": "cd billing && npm run start:dev",
    "start:billing": "cd billing && npm run start:prod",
    "start:chat:dev": "cd chat && npm run start:dev",
    "start:chat": "cd chat && npm run start:prod",
    "check:orders": "cd orders && npm run check",
    "check:product": "cd product && npm run check",
    "check:documents": "cd documents && npm run check",
    "check:automation": "cd automation && npm run check",
    "check:notification": "cd notification && npm run check",
    "check:audit": "cd audit && npm run check",
    "check:billing": "cd billing && npm run check",
    "check:chat": "cd chat && npm run check",
    "build:orders": "cd orders && npm run build",
    "build:product": "cd product && npm run build",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "allure:report": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "proto:descriptors": "bash proto/scripts/gen-descriptors.sh"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@fairflow/shared": "*",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.15",
    "allure-commandline": "^2.43.0",
    "allure-jest": "^3.10.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "mongodb": "^6.12.0",
    "pg": "^8.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
