{
  "name": "fairflow-product-service",
  "version": "1.0.0",
  "description": "Product CRM gRPC domain service",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "prestart:dev": "true",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/{main.ts,app.module.ts,auth-validation/**/*.ts,config/**/*.ts,feature-toggle/**/*.ts,health/**/*.ts,metrics/**/*.ts,mongo/**/*.ts,product/**/*.ts,idempotency/**/*.ts,common/**/*.ts}\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "tsc --noEmit && npm run lint && npm run test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "db:seed": "echo no seed for mongo",
    "db:backfill:legacy": "ts-node scripts/backfill-legacy-fields.ts",
    "db:backfill:legacy:check": "ts-node scripts/backfill-legacy-fields.ts --check"
  },
  "dependencies": {
    "@fairflow/shared": "*",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@grpc/grpc-js": "^1.12.4",
    "amqplib": "^0.10.5",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mercurius": "^13.2.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.8.2",
    "graphql": "^16.13.1",
    "jwks-rsa": "^3.1.0",
    "mercurius": "^16.8.0",
    "mongodb": "^6.21.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "dotenv": "^16.4.5",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "<rootDir>/../..",
    "rootDir": "src"
  }
}
