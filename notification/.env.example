HTTP_PORT=3015
GRPC_NOTIFICATION_PORT=5015

MONGODB_URI=mongodb://root:fairflow@localhost:27017/fairflow?authSource=admin
AUTH_GRPC_URL=127.0.0.1:5001
# control ProjectGrpc — project-wide fan-out (PA/leader/all members) for the
# materialization consumer (FR-MNOT-4/31). Fail-soft when unreachable.
CONTROL_GRPC_URL=127.0.0.1:5002
# ActivityGrpc — reminder fire claim/release (TODO-116 scheduler).
ACTIVITY_GRPC_URL=127.0.0.1:5008
NODE_ENV=development

GATEWAY_KEY_CACHE_TTL_MS=60000
GRPC_REFLECTION_ENABLED=false

# Realtime SSE badge signals (FR-MNOT-9). When set, the domain PUBLISHES a tiny
# `badge` frame on `notif:user:{userId}` (the channel the gateway SSE subscribes
# to) on materialize / markRead / markAllRead. Unset → no-op, SSE degrades to
# client polling (NFR-MNOT-2). Same Redis as the gateway realtime seam.
REDIS_URL=

# Service key (ak_…) for s2s calls: auth UserDirectoryGrpc.ResolveUsers (PII
# recipient lookup) and control ProjectGrpc.ListMembers (fan-out). Falls back to
# GATEWAY_SERVICE_API_KEY when unset.
NOTIFICATION_SERVICE_API_KEY=

# --- Email (outbound) ------------------------------------------------------
# Master switch. When false (default for local dev / feature stands) the mailer
# is a no-op and notifications degrade to in-app only.
MAIL_ENABLED=false

# SMTP relay. On the app stand / prod this is the shared outbound
# relay (host-Postfix -> upstream provider). It trusts the source via Postfix
# permit_mynetworks, so NO auth is used; the pod must reach it by LAN IP, set via
#   hostAliases: smtp.example.com -> <mail-host-lan-ip>   (NOT the public IP).
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=25
MAIL_SMTP_SECURE=false        # false on :25 — TLS via STARTTLS (below)
MAIL_SMTP_STARTTLS=true       # require STARTTLS upgrade
MAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true   # set to false only for a relay with a self-signed cert
# Auth may be empty for a relay that trusts the network (permit_mynetworks). Set for an authed relay:
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Envelope From MUST be <local>@example.com (Postbox identity = your mail domain).
MAIL_FROM=FairFlow <notifications@example.com>
# MAIL_REPLY_TO=

# Used to build email CTA / preferences links (prod: https://app.example.com).
APP_PUBLIC_URL=http://localhost:5173
# USER_EMAIL_CACHE_TTL_MS=300000  # recipient lookup cache TTL
