HTTP_PORT=3012
GRPC_AUTOMATION_PORT=5012

MONGODB_URI=mongodb://root:fairflow@localhost:27017/fairflow?authSource=admin
AUTH_GRPC_URL=127.0.0.1:5001
NODE_ENV=development

GATEWAY_KEY_CACHE_TTL_MS=60000
GRPC_REFLECTION_ENABLED=false

# At-rest encryption key for connection secrets (AES-256-GCM, fail-closed).
# Any string >=16 chars (hashed to 256 bit); generate: openssl rand -base64 32
# Without it CreateConnection/UpdateConnection with a secret fails with
# SECRET_ENCRYPTION_UNAVAILABLE and webhooks go out unsigned. Losing/rotating
# the key makes previously sealed secrets unreadable — store it safely.
AUTOMATION_SECRET_KEY=

# Automation's OWN service API key (ak_..., scope gateway:invoke) for outbound
# s2s calls (activity executor, control module-state lookups). Issued by the
# seed/provisioner: set SEED_AUTOMATION_SERVICE_API_KEY for postgres-seed or
# AUTOMATION_SERVICE_API_KEY for provision-box; the resulting id is printed and
# written to .fairflow-dev.env as AUTOMATION_API_KEY_ID.
AUTOMATION_SERVICE_API_KEY=
AUTOMATION_API_KEY_ID=

# Outbound gRPC targets for action executors / module-state gate. When unset the
# corresponding feature reports itself unavailable (deferred / fail-open + warn).
ACTIVITY_GRPC_URL=127.0.0.1:5008
CONTROL_GRPC_URL=127.0.0.1:5002
# ManualRun entity readers (§3.8 IDOR mitigation, TODO-067): the target record is
# fetched from its source domain under the caller's propagated visibility/ABAC.
# Unset = ManualRun for that entity type fails with 'Entity reader unavailable'.
PIPE_GRPC_URL=127.0.0.1:5005
CONTACT_GRPC_URL=127.0.0.1:5003
COMPANY_GRPC_URL=127.0.0.1:5004
ORDERS_GRPC_URL=127.0.0.1:5006
# send_email executor → notification.SendTransactionalEmail (TODO-039). Unset =
# every send_email / order email final action fails terminally with
# `email_transport_not_configured`. Actual delivery still needs MAIL_ENABLED=true
# + MAIL_SMTP_* on the notification service, otherwise it answers
# `email_transport_disabled`.
# send_notification executor also uses NOTIFICATION_GRPC_URL (NotificationGrpc.Send).
NOTIFICATION_GRPC_URL=127.0.0.1:5015

# TODO-039 (remainder): targets of the entity-generic actions. `assign_user` /
# `change_stage` / `update_field` reach the domain that owns the triggering
# record; an unset address makes that action fail terminally with
# `<action>_target_not_configured` instead of silently doing nothing.
PIPE_GRPC_URL=127.0.0.1:5005
CONTACT_GRPC_URL=127.0.0.1:5003
COMPANY_GRPC_URL=127.0.0.1:5004
ORDERS_GRPC_URL=127.0.0.1:5006

# Deadline for one SendTransactionalEmail call (ms). Must stay above the mailer's
# SMTP socket timeout (20s) so a slow relay is not reported as a transport fault.
AUTOMATION_EMAIL_TIMEOUT_MS=30000

# Deadline for one executor→domain call (assign_user / change_stage /
# update_field / send_notification).
AUTOMATION_EXECUTOR_TIMEOUT_MS=15000

# TODO-041 — background DLQ auto-retry. The sweeper polls rows whose
# `next_retry_at` is due, re-dispatches them with a FRESH idempotency generation
# and backs off exponentially (30s → 60s → 300s → …, capped) until the attempt
# cap, after which the row goes terminal `exhausted` and waits for a human.
#
# DELIVERY SEMANTICS: AT-LEAST-ONCE. With auto-retry ON an outbound action can
# reach its target more than once (a webhook that answers after
# AUTOMATION_WEBHOOK_TIMEOUT_MS was still delivered), so every `send_webhook`
# POST carries a dedup key: `deliveryId` in the signed body + the
# `x-fairflow-delivery-id` header, stable across re-sends, with the attempt
# number in `attempt` / `x-fairflow-attempt` (0 = first delivery). Receivers MUST
# dedup on `deliveryId`. Set AUTOMATION_DLQ_AUTORETRY_ENABLED=false for
# at-most-once-ish behaviour (retry then only ever happens when a human presses
# it); the retry itself stays available either way.
AUTOMATION_DLQ_AUTORETRY_ENABLED=true
AUTOMATION_DLQ_SWEEP_INTERVAL_MS=30000
AUTOMATION_DLQ_SWEEP_BATCH=20
AUTOMATION_DLQ_MAX_ATTEMPTS=5
AUTOMATION_DLQ_BACKOFF_CAP_MS=3600000
# Attempt cap for an AMBIGUOUS outcome of an EXTERNAL-effect action (send_webhook
# / send_email): timeout, socket hang up, deadline — the request was already on
# the wire, so "failed" does not mean "not delivered". Such a row gets the first
# delivery plus this many minus one automatic re-sends (default: exactly one),
# then waits for a human instead of multiplying the external effect. Unambiguous
# faults (connection refused, DNS, HTTP 5xx) keep the full ladder above.
AUTOMATION_DLQ_AMBIGUOUS_MAX_ATTEMPTS=2
# Claim lease. A row `retrying` for longer than this lost its runner (pod killed
# between claim and outcome) and is reclaimed by the next sweep. Keep it well
# above the slowest single dispatch (email executor 30s) so a live dispatch is
# never stolen from under itself.
AUTOMATION_DLQ_RETRY_LEASE_MS=300000

# TTL of the per-project module-state cache used by the runtime freeze gate.
AUTOMATION_MODULE_STATE_TTL_MS=30000
