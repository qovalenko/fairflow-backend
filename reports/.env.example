HTTP_PORT=3011
GRPC_REPORTS_PORT=5011

MONGODB_URI=mongodb://root:fairflow@localhost:27017/fairflow?authSource=admin
AUTH_GRPC_URL=127.0.0.1:5001
# [#19] control gRPC for domain-side deferred-scope hydration (large-org visibility).
CONTROL_GRPC_URL=127.0.0.1:5002
NODE_ENV=development

GRPC_REFLECTION_ENABLED=false

# --- Source-domain gRPC (name resolution / future Aggregate RPCs) ------------
PIPE_GRPC_URL=127.0.0.1:5005
ORDERS_GRPC_URL=127.0.0.1:5006
CONTACT_GRPC_URL=127.0.0.1:5003
COMPANY_GRPC_URL=127.0.0.1:5004

# --- Statistics dashboard tuning ---------------------------------------------
# Days without stage movement before a deal is considered «stalled» (FR-MSTAT-30).
STATISTICS_STALLED_DAYS=7

# --- Event bus (RFC-4) -------------------------------------------------------
# Broker for the transactional-outbox relay AND the statistics-rollup consumer.
RABBITMQ_URL=amqp://fairflow:fairflow@localhost:5672/
# Prefixes every bus object (exchange/queues/DLX). Default 'fairflow' on main.
BUS_NAMESPACE=fairflow
# Publish outbox rows to the bus (set false on read-only replicas / tests).
OUTBOX_RELAY_ENABLED=true
# Materialize crm.deal.*/crm.order.*/crm.activity.* into statistics_rollup cells
# (P2.f). Set false to disable the consumer (tests / read-only replicas).
#
# TODO-497/TODO-469 — состояние витрины на сегодня: она ПИШЕТСЯ и НЕ ЧИТАЕТСЯ.
# Дашборд и аналитика по-прежнему пересчитывают агрегаты на лету (см.
# reports.service.ts getDashboard/getMetrics), потому что исторический backfill
# ячеек не сделан: read-switch без него показал бы нули за период до включения
# консьюмера. Практические следствия для эксплуатации:
#   * включённый по умолчанию консьюмер — ЗАДЕЛ под будущий read-switch, на
#     выдачу он сейчас не влияет; выключение флагом ничего не ломает в UI и
#     стоит только потери накопления ячеек (после обратного включения дыра в
#     истории остаётся до backfill-джобы);
#   * guard-коллекция дедупликации (statistics_rollup_msgs) чистится по TTL —
#     STATISTICS_ROLLUP_MSGS_TTL_SEC ниже, историю она не хранит.
REPORTS_ROLLUP_CONSUMER_ENABLED=true
# Read-switch onto rollup cells (NFR-010). Requires backfill marker in
# `statistics_rollup_state` — run `reports/scripts/backfill-statistics-rollup.ts`.
STATISTICS_ROLLUP_READ_ENABLED=true
# Event-sourced stage transitions (FR-REPORTS-250).
REPORTS_STAGE_TRANSITIONS_ENABLED=true

# --- gRPC-клиенты домена -----------------------------------------------------
# Домен-владелец воронок: карта стадий (stageId → название/порядок) для дашборда
# и подписей срезов. Без него срезы отдаются с голыми id (TODO-462/FR-MSTAT-10).
PIPE_GRPC_URL=127.0.0.1:5005
# Сервисный ключ ИСХОДЯЩЕГО вызова reports → pipe (s2s, НЕ end-user JWT).
# Если пуст — берётся GATEWAY_SERVICE_API_KEY (совместимость со старыми стендами).
REPORTS_SERVICE_API_KEY=
GATEWAY_SERVICE_API_KEY=
# Кэш карты стадий и cooldown после неудачного похода в pipe (мс).
REPORTS_STAGE_CACHE_TTL_MS=60000
REPORTS_STAGE_FAIL_COOLDOWN_MS=10000
# Response-cache дашборда (FR-MSTAT-18 / FR-STAT-350): TTL on-demand агрегатов (мс).
REPORTS_DASHBOARD_CACHE_TTL_MS=60000
REPORTS_DASHBOARD_CACHE_MAX=1000

# --- Статистика --------------------------------------------------------------
# IANA-таймзона, в которой считаются границы периода и подписи дневных бакетов.
# Пусто/нераспознанное значение → UTC (с предупреждением в логе).
STATISTICS_TZ=UTC
# Сколько дней без движения делают сделку «зависшей» в виджете дашборда.
STATISTICS_STALLED_DAYS=7
# TTL guard-коллекции дедупликации rollup-событий (сек). Окно должно
# перекрывать повторные доставки брокера, а не хранить историю.
STATISTICS_ROLLUP_MSGS_TTL_SEC=604800

# --- Шина: имя обменника (переопределение) -----------------------------------
# По умолчанию берётся из @fairflow/shared (BUS_MAIN_EXCHANGE / OUTBOX_EXCHANGE).
# RABBITMQ_EXCHANGE=fairflow.events

# --- Кэш валидации gateway-ключа (входящие gRPC-вызовы) ----------------------
GATEWAY_KEY_CACHE_TTL_MS=60000
GATEWAY_KEY_STALE_GRACE_MS=600000
GATEWAY_KEY_CACHE_MAX=1000
