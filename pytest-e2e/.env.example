# Copy to `.env` and fill in for your own stand. Every value below is a
# placeholder — the defaults point at a local docker/dev stack only.
# Nothing in this repository may ever contain a real host, login or key.

# ── REST: the gateway is the single public entrypoint (docs/01-architecture.md §1)
FAIRFLOW_GATEWAY_URL=http://localhost:3000

# Credentials of a project owner/admin on the stand. Without them every
# REST test SKIPs (self-registration is disabled on the box edition, so the
# suite cannot provision its own account).
FAIRFLOW_ADMIN_EMAIL=
FAIRFLOW_ADMIN_PASSWORD=

# ── gRPC: one domain service, addressed directly (docs/02-grpc-model.md §1)
# `contact` listens on 5003 in the dev topology.
FAIRFLOW_CONTACT_GRPC=localhost:5003

# Service API key the gateway presents to domains (`ak_…`) and its id.
# Layer 2 of the authorization model (docs/02-grpc-model.md §3). Without them
# only the NEGATIVE gRPC tests run; the positive one SKIPs.
FAIRFLOW_SERVICE_API_KEY=
FAIRFLOW_GATEWAY_API_KEY_ID=

# ── proto sources used to generate the python stubs (`make protos`)
FAIRFLOW_PROTO_DIR=../fairflow-backend/proto

# ── misc
FAIRFLOW_HTTP_TIMEOUT=30
