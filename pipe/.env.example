HTTP_PORT=3005
GRPC_PIPE_PORT=5005

PORT=3005
HOST=0.0.0.0
NODE_ENV=development

MONGODB_URI=mongodb://root:fairflow@localhost:27017/fairflow?authSource=admin

AUTH_GRPC_URL=127.0.0.1:5001
# [#19] control gRPC for domain-side deferred-scope hydration (large-org visibility).
CONTROL_GRPC_URL=127.0.0.1:5002

JWT_SECRET=change-me-in-production
JWT_EXPIRE=7d

CORS_ORIGIN=*
CORS_CREDENTIALS=false

SLEEP_BEFORE_SHUTDOWN_MS=5000
FORCE_SHUTDOWN_TIMEOUT_MS=30000

LOG_LEVEL=debug
GRPC_REFLECTION_ENABLED=false

# --- Inbound bus / project-purge consumer (control.project.purged -> drop per-project data) ---
RABBITMQ_URL=amqp://fairflow:fairflow@localhost:5672/
# Toggle the project-purge consumer across CRM domains (default: enabled).
PROJECT_PURGE_CONSUMERS_ENABLED=true
