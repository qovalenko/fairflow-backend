# PostgreSQL
POSTGRES_USER=fairflow
POSTGRES_PASSWORD=fairflow
POSTGRES_DB=fairflow
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://fairflow:fairflow@localhost:5432/fairflow

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=fairflow
MONGO_DB=fairflow
MONGO_PORT=27017
# MONGODB_URI=mongodb://root:fairflow@localhost:27017/fairflow?authSource=admin

# Redis
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=fairflow
RABBITMQ_PASSWORD=fairflow
RABBITMQ_AMQP_PORT=5672
RABBITMQ_HTTP_PORT=15672
# RABBITMQ_URL=amqp://fairflow:fairflow@localhost:5672/

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=fairflow

# App service ports (docker compose --profile apps up)
DOCUMENTS_GRPC_PORT=5010
DOCUMENTS_HTTP_PORT=3010
REPORTS_GRPC_PORT=5011
REPORTS_HTTP_PORT=3011
AUTOMATION_GRPC_PORT=5012
AUTOMATION_HTTP_PORT=3012
SEARCH_GRPC_PORT=5013
SEARCH_HTTP_PORT=3013
AUDIT_GRPC_PORT=5014
AUDIT_HTTP_PORT=3014
NOTIFICATION_GRPC_PORT=5015
NOTIFICATION_HTTP_PORT=3015
BILLING_GRPC_PORT=5016
BILLING_HTTP_PORT=3016

# Shared auth for domain services
# AUTH_GRPC_URL=auth:5001
# GATEWAY_INBOUND_API_KEY=dev-gateway-inbound-key

# Observability (optional: docker-compose --profile observability up)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
