# docker compose build.context: ..  (services/)  dockerfile: docker/Dockerfile.crm-grpc
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
COPY shared ./shared
COPY proto ./proto
COPY crm-grpc ./crm-grpc
RUN npm ci 2>/dev/null || npm install
WORKDIR /app/crm-grpc
RUN npm run build
ENV NODE_ENV=production
# commit provenance for /status.commit — late so it never invalidates the build layers above
ARG GIT_COMMIT=""
ARG IMAGE_TAG=""
ENV GIT_COMMIT=${GIT_COMMIT} \
    IMAGE_TAG=${IMAGE_TAG}
EXPOSE 5020 5021 5022 5023 5025 5099
CMD ["node", "dist/main.js"]
