HTTP_PORT=3016
GRPC_CHAT_PORT=5017

MONGODB_URI=mongodb://root:fairflow@localhost:27017/fairflow?authSource=admin
AUTH_GRPC_URL=127.0.0.1:5001
NODE_ENV=development

RABBITMQ_URL=amqp://fairflow:fairflow@localhost:5672/
# BUS_NAMESPACE isolates the durable exchange (<BUS_NAMESPACE>.events).
# OUTBOX_RELAY_ENABLED=false disables the background publisher (tests).

GATEWAY_KEY_CACHE_TTL_MS=60000
GRPC_REFLECTION_ENABLED=false
