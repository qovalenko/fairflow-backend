PORT=3000
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://fairflow:fairflow@localhost:5432/fairflow

JWT_SECRET=change-me-in-production
# Access token TTL (default 24h).
JWT_EXPIRE=24h

# Session deny-list PEP: ON by default (revoked/logged-out sessions rejected
# before their exp). Set to false/0/off to opt out (avoids a per-request round-trip to auth).
AUTH_SESSION_DENYLIST=true

# Из services/.fairflow-dev.env после npm run db:provision / seed:all
GATEWAY_SERVICE_API_KEY=
GATEWAY_API_KEY_ID=

# Секрет для JWT пользователя — тот же смысл, что и у auth при выдаче токена (локально выровнять вручную).

AUTH_GRPC_URL=127.0.0.1:5001
CONTROL_GRPC_URL=127.0.0.1:5002
CONTACT_GRPC_URL=127.0.0.1:5003
COMPANY_GRPC_URL=127.0.0.1:5004
PIPE_GRPC_URL=127.0.0.1:5005
ORDERS_GRPC_URL=127.0.0.1:5006
PRODUCT_GRPC_URL=127.0.0.1:5007
ACTIVITY_GRPC_URL=127.0.0.1:5008
DOCUMENTS_GRPC_URL=127.0.0.1:5010
REPORTS_GRPC_URL=127.0.0.1:5011
AUTOMATION_GRPC_URL=127.0.0.1:5012
SEARCH_GRPC_URL=127.0.0.1:5013
AUDIT_GRPC_URL=127.0.0.1:5014
NOTIFICATION_GRPC_URL=127.0.0.1:5015
BILLING_GRPC_URL=127.0.0.1:5016
CHAT_GRPC_URL=127.0.0.1:5017

# S3/MinIO for user avatars
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_AVATARS_BUCKET=fairflow-avatars
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000

# Отзыв прав (Д-6 Stage-0): TTL кэша решения о доступе (членство/роль/scope) в мс.
# Низкий минимум сокращает лаг отзыва с ~30с до пары секунд. 0 = кэш выключен (re-resolve каждый запрос).
GATEWAY_ACCESS_CACHE_TTL_MS=5000
# BOX (NFR-560): обязательное принудительное PEP членства/роли на gateway.
# В коробке должно быть явно true; при false gateway не стартует (FR-PROJ-065).
GATEWAY_PROJECT_ACCESS_ENFORCE=true
# TTL кэша module-policy оверлея (проектный, не per-user) в мс.
GATEWAY_POLICY_CACHE_TTL_MS=30000

CORS_ORIGIN=*
CORS_CREDENTIALS=false
LOG_LEVEL=debug

# Выгрузка продаж (GET /v1/orders/export) — бюджет одного запроса и защита от усиления.
# Один запрос листает домен страницами по 100 (потолок 10 000 строк) и резолвит имена
# одиночными Get* в product/pipe/contact/company, поэтому ограничены и время, и число вызовов,
# и количество ОДНОВРЕМЕННЫХ выгрузок (сверх лимита — 429 EXPORT_RATE_LIMITED).
ORDERS_EXPORT_BUDGET_MS=45000
ORDERS_EXPORT_NAME_RPC_BUDGET=2000
ORDERS_EXPORT_MAX_INFLIGHT_PER_USER=1
ORDERS_EXPORT_MAX_INFLIGHT_PER_PROJECT=2
ORDERS_EXPORT_MAX_INFLIGHT=4

# Доверять X-Forwarded-For (client IP для lockout/сессий). ОБЯЗАТЕЛЬНО true за
# ingress/reverse-proxy — иначе все клиенты видны как один IP прокси и общий
# IP-lockout может зацепить всех. false — только при прямом доступе к gateway.
TRUST_PROXY=false
