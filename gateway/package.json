{
  "name": "fairflow-gateway",
  "version": "1.0.0",
  "description": "API Gateway \u2014 single entry point, JWT, routing",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "prestart:dev": "prisma generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "tsc --noEmit && npm run lint && npm run test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1012.0",
    "@aws-sdk/s3-request-presigner": "3.1012.0",
    "@fairflow/shared": "*",
    "@fairflow/testing": "*",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.0.0",
    "@grpc/grpc-js": "^1.12.4",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.17",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "amqplib": "^0.10.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.8.2",
    "ioredis": "^5.4.1",
    "jwks-rsa": "^3.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@fairflow/testing": "*",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "dotenv": "^16.4.5",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts"
  },
  "jest": {
    "preset": "<rootDir>/../..",
    "rootDir": "src",
    "setupFiles": ["<rootDir>/../box-integration-setup.cjs"],
    "transformIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/../../testing/dist/"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "diagnostics": false
        }
      ]
    },
    "moduleNameMapper": {
      "^@nestjs/(.*)$": "<rootDir>/../../node_modules/@nestjs/$1",
      "^@fairflow/testing$": "<rootDir>/../../testing/dist/index.js",
      "^@fairflow/shared$": "<rootDir>/../../shared/dist/index.js"
    },
    "coverageThreshold": {
      "./src/guards/": {
        "lines": 90,
        "branches": 75,
        "functions": 90
      },
      "./src/bff/grpc-bff-call.ts": {
        "lines": 95,
        "branches": 90,
        "functions": 100
      }
    }
  }
}
