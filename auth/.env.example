PORT=3001
GRPC_PORT=5001
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://fairflow:fairflow@localhost:5432/fairflow

JWT_SECRET=change-me-in-production
# Access token TTL (default 24h). Paired with the gateway session deny-list PEP.
JWT_EXPIRE=24h

# REQUIRED outside development (NODE_ENV != development/test): at-rest AES-256-GCM
# key for user TOTP (2FA) secrets. The service refuses to start without it.
# Set a strong random value once; rotating it makes already-stored 2FA secrets
# undecryptable (affected users must re-enroll 2FA).
AUTH_2FA_KEY=

# Required for prisma seed: gateway service API key (ak_…), then copy to GATEWAY_SERVICE_API_KEY on gateway
SEED_GATEWAY_SERVICE_API_KEY=

# Optional scoped s2s directory keys (ak_…), scope internal:user-directory — for
# notification/control calls to UserDirectoryGrpc.ResolveUsers. If set, seed upserts
# them; copy to NOTIFICATION_SERVICE_API_KEY / CONTROL_SERVICE_API_KEY on those pods.
SEED_NOTIFICATION_SERVICE_API_KEY=
SEED_CONTROL_SERVICE_API_KEY=

# Gate enforcement of the service key on UserDirectoryGrpc.ResolveUsers.
# BOX: enforce fail-closed (FR-AUTH-400).
REQUIRE_KEY_FOR_RESOLVE_USERS=true

# Required outside development for distributed login brute-force tracking (NFR-AUTH-040 / FR-AUTH-060).
REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug

# Dev only: gRPC Server Reflection for grpcurl/postman (never enable in production)
GRPC_REFLECTION_ENABLED=false

# --- External OIDC SSO (FR-AUTH-350): Fairflow as an OIDC *client* ---
# JSON array of external IdPs (Keycloak / ADFS / Yandex ID …) — lets the box
# customer plug corporate SSO without a rebuild. Merged with the OidcProvider
# DB table (env wins on id collision). Endpoints may be omitted: the gateway
# resolves them via `<issuer>/.well-known/openid-configuration`.
# `trustEmail: true` (env only) accepts a provider email without an explicit
# `email_verified` claim (e.g. ADFS); default is to REJECT unverified emails.
# OIDC_PROVIDERS='[{"id":"keycloak","name":"Corporate SSO","issuer":"https://kc.example.com/realms/main","clientId":"fairflow","clientSecret":"...","scopes":["openid","profile","email"]}]'
OIDC_PROVIDERS=
